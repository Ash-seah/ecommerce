ENVIRONMENT=development
APP_NAME=Ecommerce Sandbox API
API_PORT=8001

# Generate independent values; never reuse credentials from another application.
ECOMMERCE_OWNER_PASSWORD=replace-with-generated-owner-password
ECOMMERCE_READER_PASSWORD=replace-with-generated-reader-password
DATABASE_URL=postgresql+asyncpg://ecommerce_reader:replace-with-generated-reader-password@postgres:5432/ecommerce_master
MIGRATION_DATABASE_URL=postgresql+asyncpg://ecommerce_owner:replace-with-generated-owner-password@postgres:5432/ecommerce_master

REDIS_URL=redis://redis:6379/1
REDIS_KEY_PREFIX=ecommerce

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ecommerce-dev
MINIO_SECRET_KEY=replace-with-generated-minio-secret
MINIO_SECURE=false
MINIO_MASTER_BUCKET=ecommerce-master
MINIO_SANDBOX_BUCKET=ecommerce-sandboxes
# Optional only when a gateway serves these object paths without MinIO signatures.
# MEDIA_PUBLIC_BASE_URL=https://media.invalid.example
MEDIA_WORKER_CONCURRENCY=4

SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-a-different-32-character-secret
SESSION_TTL_SECONDS=7200
SESSION_COOKIE_NAME=ecommerce_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

CORS_ORIGINS=["http://localhost:3000"]
MAX_REQUEST_BODY_BYTES=12582912
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
READINESS_TIMEOUT_SECONDS=2
# Comma-separated IPs/CIDRs trusted by Uvicorn for Forwarded/X-Forwarded-*.
# Never use * in production.
TRUSTED_PROXY_IPS=127.0.0.1
COMMERCE_PAGE_MAX=100
CART_QUANTITY_MAX=20
ADDRESS_MAX=10
DEMO_WALLET_INITIAL_MINOR=100000
DEMO_WALLET_CURRENCY=USD
DEMO_STOCK_DEFAULT=100
SHIPPING_FLAT_MINOR=500
FREE_SHIPPING_THRESHOLD_MINOR=5000
TAX_BASIS_POINTS=0

# Compose/shared-infrastructure settings (not consumed by the API settings model).
SHARED_NETWORK_NAME=terabit-fintech_default
POSTGRES_CONTAINER=terabit-fintech-postgres-1
POSTGRES_SUPERUSER=financial
POSTGRES_SERVICE_HOST=postgres
REDIS_SERVICE_HOST=redis
